#!/bin/bash
# gemini-fix — drží hook proti crashu Gemini v MIUI libmedia.
#   bin/gemini-fix start|stop|status|restart
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIDFILE="$ROOT/logs/gemini-fixd.pid"
LOG="$ROOT/logs/gemini-fixd.log"
PY="$ROOT/.venv/bin/python"
mkdir -p "$ROOT/logs"

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start() {
  if running; then echo "už běží (pid $(cat "$PIDFILE"))"; return 0; fi
  setsid nohup "$PY" "$ROOT/bridge/gemini_fixd.py" >"$LOG" 2>&1 </dev/null &
  sleep 3
  if running; then echo "spuštěno (pid $(cat "$PIDFILE"))"; tail -3 "$LOG"
  else echo "CHYBA — viz $LOG"; tail -5 "$LOG"; return 1; fi
}
stop() {
  if [ -f "$PIDFILE" ]; then kill "$(cat "$PIDFILE")" 2>/dev/null; fi
  for p in $(ls /proc | grep -E '^[0-9]+$'); do
    c=$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null) || continue
    case "$c" in *gemini_fixd*) kill "$p" 2>/dev/null;; esac
  done
  sleep 1; running && echo "pořád běží?" || echo "zastaveno"
}
status() {
  if running; then echo "běží (pid $(cat "$PIDFILE"))"; else echo "neběží"; fi
  echo "--- log ---"; tail -6 "$LOG" 2>/dev/null || true
}
case "${1:-status}" in
  start) start;; stop) stop;; restart) stop; start;; status) status;;
  *) echo "použití: $0 start|stop|restart|status"; exit 2;;
esac
